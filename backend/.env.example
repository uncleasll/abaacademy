APP_ENV=production
DATABASE_URL=postgresql://abaacademy:change-me@localhost:5432/abaacademy
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL_SECONDS=43200
# Class days, due dates and "overdue" follow this timezone (the server itself runs in UTC).
ACADEMY_TIMEZONE=America/New_York
# Optional: reuse PostgreSQL connections (try 5). Leave unset until verified against production.
# DB_POOL_MAX=5
FRONTEND_URLS=https://abaacademy.vercel.app,http://localhost:5173
# Full contents of backend/private/teachers-bootstrap.json; all eight accounts required.
STAFF_ACCOUNTS_JSON=
TELEGRAM_BOT_TOKEN=
# Name shown in the daily attendance post header.
TELEGRAM_ACADEMY_NAME=Al-Bukhari Academy
# The real class chats are built in (teacher → chat ids for G1, G2, ...) and linked to each teacher's groups at startup.
# Set this JSON to override that list, or {} to link nothing automatically. Chats saved on the Groups page are never overwritten.
# TELEGRAM_GROUP_CHATS_JSON={"Firuz": ["-1003406651107"]}
# How often (seconds) class days whose post never reached Telegram are re-sent; 0 turns the background check off.
TELEGRAM_CATCHUP_SECONDS=1800
